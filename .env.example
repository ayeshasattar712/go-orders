# =============================================================================
# GoOrder — Environment Variables
# Copy to .env.local / .env.development / .env.staging / .env.production
# NEVER commit real secrets. Rotate keys regularly.
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME="GoOrder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Cookie
COOKIE_DOMAIN="localhost"

# Security
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Logging
LOG_LEVEL="debug"

# Database (Postgres via Prisma) — run `docker compose up -d` for local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goorder"

# NextAuth (Auth.js) — separate secrets per surface, generate with: openssl rand -base64 64
# Distinct secrets are what actually stop a customer session token being replayed
# against the admin instance (or vice versa), not just the cookie name.
NEXTAUTH_SECRET_CUSTOMER="change-me-customer-secret-min-32-chars-long!"
NEXTAUTH_SECRET_ADMIN="change-me-admin-secret-min-32-chars-long!!!"

# Optional integrations
# REDIS_URL=""
# SENTRY_DSN=""
