# =============================================================================
# Enterprise Next.js Boilerplate — Environment Variables
# Copy to .env.local / .env.development / .env.staging / .env.production
# NEVER commit real secrets. Rotate keys regularly.
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME="Enterprise App"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Auth (server-only) — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie / CSRF
COOKIE_DOMAIN="localhost"
CSRF_SECRET="change-me-csrf-secret-min-32-characters-long!"

# Security
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Logging
LOG_LEVEL="debug"

# Optional integrations
# DATABASE_URL=""
# REDIS_URL=""
# SENTRY_DSN=""
