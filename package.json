{
  "name": "go-order",
  "version": "1.0.0",
  "private": true,
  "description": "GoOrder — B2B/B2C corporate procurement, vendor management, inventory, and accounting ERP platform. Two separate apps: apps/client (marketplace + customer account) and apps/admin (staff admin panel + ERP workspace).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n client,admin -c blue,magenta \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "vercel-build": "node scripts/vercel-build.cjs",
    "start:client": "npm run start --workspace=apps/client",
    "start:admin": "npm run start --workspace=apps/admin",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "node -e \"if (process.env.VERCEL || process.env.CI) process.exit(0); require('child_process').execSync('husky', {stdio:'inherit', shell:true})\"",
    "postinstall": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db",
    "dev:chat": "tsx server/chat-server.ts",
    "dev:all": "concurrently -n client,admin,chat -c blue,magenta,green \"npm:dev:client\" \"npm:dev:admin\" \"npm:dev:chat\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  }
}
