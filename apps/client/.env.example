# =============================================================================
# GoOrder Client — Environment Variables
# Copy to .env.local / .env.development / .env.staging / .env.production
# NEVER commit real secrets. Rotate keys regularly.
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME="GoOrder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Cookie
COOKIE_DOMAIN="localhost"

# Security
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Logging
LOG_LEVEL="debug"

# Database (Postgres via Prisma) — run `docker compose up -d` from the repo root
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goorder"

# NextAuth (Auth.js) — customer-surface secret only. Generate with: openssl rand -base64 64
NEXTAUTH_SECRET_CUSTOMER="change-me-customer-secret-min-32-chars-long!"

# Chat
NEXT_PUBLIC_CHAT_SERVER_URL="http://localhost:3002"

# -----------------------------------------------------------------------------
# Vercel (do NOT paste this localhost file as-is)
# -----------------------------------------------------------------------------
# Required:
#   DATABASE_URL              hosted Postgres (Neon/Supabase/Vercel). localhost will not work.
#   NEXTAUTH_SECRET_CUSTOMER  openssl rand -base64 64
# Recommended:
#   NEXT_PUBLIC_APP_URL       https://your-app.vercel.app
#   ALLOWED_ORIGINS           https://your-app.vercel.app
# Leave unset (do not copy localhost values):
#   NEXT_PUBLIC_API_URL, COOKIE_DOMAIN
# After first deploy, run prisma migrate against the hosted DATABASE_URL.
