# =============================================================================
# GoOrder Admin — Environment Variables
# Copy to .env.local / .env.development / .env.staging / .env.production
# NEVER commit real secrets. Rotate keys regularly.
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME="GoOrder Admin"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Cookie
COOKIE_DOMAIN="localhost"

# Security
ALLOWED_ORIGINS="http://localhost:3001"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Logging
LOG_LEVEL="debug"

# Database (Postgres via Prisma) — run `docker compose up -d` from the repo root
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goorder"

# Shop (customer) app — used when generating client login credentials
NEXT_PUBLIC_SHOP_URL="http://localhost:3000"

# NextAuth (Auth.js) — one secret per session surface. Generate with: openssl rand -base64 64
NEXTAUTH_SECRET_ADMIN="change-me-admin-secret-min-32-chars-long!!!"
# Must match apps/client's NEXTAUTH_SECRET_CUSTOMER so a customer_session cookie
# validates on both apps when deployed behind a shared domain.
NEXTAUTH_SECRET_CUSTOMER="change-me-customer-secret-min-32-chars-long!"

# Chat
NEXT_PUBLIC_CHAT_SERVER_URL="http://localhost:3002"

# -----------------------------------------------------------------------------
# Vercel (do NOT paste this localhost file as-is)
# -----------------------------------------------------------------------------
# Required:
#   DATABASE_URL              hosted Postgres (Neon/Supabase/Vercel). localhost will not work.
#   NEXTAUTH_SECRET_ADMIN     openssl rand -base64 64
#   NEXTAUTH_SECRET_CUSTOMER  same value as the client app
# Recommended:
#   NEXT_PUBLIC_APP_URL       https://your-admin.vercel.app
#   ALLOWED_ORIGINS           https://your-admin.vercel.app
# Leave unset (do not copy localhost values):
#   NEXT_PUBLIC_API_URL, COOKIE_DOMAIN
